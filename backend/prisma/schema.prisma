datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  ATIVO
  INATIVO
}

enum Categorias {
    EDUCACAO
    ANIMAIS
    IDOSOS
    CRIANCAS
    SAUDE
    ESPORTE
    CULTURA
    ALIMENTACAO
    MEIO_AMBIENTE
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  email        String    @unique
  senha        String
  cpf          String    @unique
  telefone     String    @unique
  endereco     String
  bairro       String
  cidade       String
  estado       String
  avatarUrl   String?
  createdAt    DateTime  @default(now())
  meusProjetos Project[] @relation("Owner")
}

model Project {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  nome            String
  ownerId         String        @db.ObjectId
  owner           User          @relation("Owner", fields: [ownerId], references: [id])
  telefone        String?
  diasFuncionamento     String[]
  endereco        String
  bairro          String
  cidade          String
  estado          String
  descricao       String?
  categoria       Categorias
  avatarUrl       String?
  email           String
  instagram       String?
  facebook        String?
  site            String?
  imagensProjeto  String[]
  status          ProjectStatus @default(ATIVO)
  createdAt       DateTime      @default(now())
  userIds         String[]      @db.ObjectId
}